# Backend Environment Variables
# Copy this file to .env for local development

# Include frontend URLs and any other services that need access
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7000

# Prompted Segmentation Service URL
# Update this to match where coral-prompted-seg is running
# For local development:
PROMPTED_SEGMENTATION_BACKEND_URL=http://localhost:8001
# For Docker network:
# PROMPTED_SEGMENTATION_BACKEND_URL=http://coral-prompted-seg:8001

# Semantic Segmentation Service URL
# Update this to match where coral-automatic-seg is running
# For local development:
SEMANTIC_SEGMENTATION_BACKEND_URL=http://localhost:8002
# For Docker network:
# AUTOMATIC_SEGMENTATION_BACKEND_URL=http://coral-semantic-seg:8002

# Suggestion Segmentation Service URL
# Update this to match where coral-completion-seg is running
# For local development:
SUGGESTION_SEGMENTATION_BACKEND_URL=http://localhost:8003

# Instance Segmentation Service URL
# Update this to match where the instance-segmentation-service is running
# For local development:
INSTANCE_SEGMENTATION_BACKEND_URL=http://localhost:8004
# For Docker network:
# INSTANCE_SEGMENTATION_BACKEND_URL=http://coral-instance-seg:8004

# LLM-assisted label-space generation ("Describe your label space" assistant).
# Provider-agnostic via LiteLLM: set the model using "<provider>/<model>" naming
# and supply the matching provider API key. Generation stays disabled (the UI
# falls back to manual editing) until LABEL_SPACE_LLM_API_KEY is set.
LABEL_SPACE_LLM_MODEL=anthropic/claude-opus-4-8
LABEL_SPACE_LLM_API_KEY=
# Optional, for self-hosted / Azure / Ollama deployments:
# LABEL_SPACE_LLM_API_BASE=http://localhost:11434

# For production deployment with external network:
# ALLOWED_ORIGINS=https://coral.ni.dfki.de,http://localhost:3000
# PROMPTED_SEGMENTATION_BACKEND_URL=
# AUTOMATIC_SEGMENTATION_BACKEND_URL=

