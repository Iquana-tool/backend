# Backend Environment Variables
# Copy this file to .env for local development

# Include frontend URLs and any other services that need access
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7000

# PostgreSQL (used by docker-compose's `postgres` service and by DATABASE_URL below).
# Defaults match docker-compose.yml if left unset.
POSTGRES_USER=iquana
POSTGRES_PASSWORD=iquana
POSTGRES_DB=iquana
# Host-side port mapping for the postgres container (change if 5432 is already
# taken on your machine, e.g. by another project's Postgres).
POSTGRES_PORT=5433

# Database connection. docker-compose derives this from the POSTGRES_* vars above
# when unset, pointing at the `postgres` service. Override to point at an external
# Postgres instance, or set to a sqlite:/// URL for local development without Docker.
# DATABASE_URL=postgresql+psycopg://iquana:iquana@postgres:5432/iquana

# Login session length in minutes. There is no token refresh -- the frontend logs
# the user out on the first 401 -- so this is how long someone stays signed in.
# Defaults to 480 (8 hours); raise it if annotation sessions run longer.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- This instance -----------------------------------------------------------
# Who is running this deployment. The sign-in page reads these from GET /instance/
# at runtime, so changing one needs a backend restart but no frontend rebuild --
# which is exactly why they live here and not in frontend-react/.env.local, where
# Vite would bake them into the bundle at build time.
#
# Every value below is also editable from the admin page (Datasets -> Admin ->
# Settings), which stores an override in the database. The variables here are the
# *defaults*: an instance that never opens that page behaves exactly as this file
# says, and an override can always be reset back to it.
#
# All of them are optional. Leave them empty and the sign-in page simply reads as
# IQUANA, which is what a single-researcher local install wants. Quotes are not
# needed: values run to the end of the line, spaces and all.

# Shown as "Welcome to ...".
INSTANCE_NAME=
# Shown as "... hosted by ...", so phrase it to follow that -- including the
# article, e.g. "the Helmholtz Institute for Functional Marine Biodiversity".
INSTANCE_ORG=
# Where people without an account should ask for one. Rendered as a mailto: link
# when it contains an "@", otherwise shown as plain text.
INSTANCE_CONTACT=
# Optional one-line notice under the sign-in form, e.g. usage terms.
INSTANCE_NOTICE=

# Whether visitors may create their own account. Off unless this reads exactly
# "true", so an instance reachable from the network does not start accepting
# strangers because a variable was misspelled. With it off, /auth/register is
# refused by the API -- not merely hidden on the sign-in page.
#
# The one exception is the *first* account: nothing else creates users, so while
# the user table is empty registration is allowed regardless, and the window
# shuts as soon as that account exists. A fresh install is never locked out.
INSTANCE_ALLOW_REGISTRATION=false

# Unified AI service URL
# All AI tasks (prompted segmentation, instance suggestion, instance
# segmentation) are served by the single ai-service. The backend derives each
# task's URL as "<AI_SERVICE_URL>/<task>", so this is the only value to set.
# For local development:
AI_SERVICE_URL=http://localhost:8004
# For Docker network:
# AI_SERVICE_URL=http://coral-ai-service:8004

# Optional per-task overrides. Leave unset to use AI_SERVICE_URL. Set one only to
# route a single task to a separate (satellite) service whose model cannot share
# the unified service's environment, e.g.:
# PROMPTED_SEGMENTATION_BACKEND_URL=http://localhost:8004/prompted-segmentation
# SUGGESTION_SEGMENTATION_BACKEND_URL=http://localhost:8004/instance-suggestion
# INSTANCE_SEGMENTATION_BACKEND_URL=http://localhost:8004/instance-segmentation

# --- Talking to the AI service ------------------------------------------------
# Shared secret guarding the AI service's PATCH /config endpoint, which the admin
# page uses to send it the Hugging Face token. Set the SAME value in
# ai-service/.env. Optional and unset by default, which leaves that endpoint open
# -- fine when the AI service is reachable only from this backend (the usual
# single-machine install), and NOT fine if its port is exposed to a network,
# where anyone reaching it could replace the token it authenticates to
# HuggingFace with.
# AI_SERVICE_ADMIN_TOKEN=

# LLM-assisted label-space generation ("Describe your label space" assistant).
# Also editable from the admin page, which is the better place to rotate the key:
# the change takes effect on the next generation rather than the next restart.
# Provider-agnostic via LiteLLM: set the model using "<provider>/<model>" naming
# and supply the matching provider API key. Generation stays disabled (the UI
# falls back to manual editing) until LABEL_SPACE_LLM_API_KEY is set.
LABEL_SPACE_LLM_MODEL=anthropic/claude-opus-4-8
LABEL_SPACE_LLM_API_KEY=
# Optional, for self-hosted / Azure / Ollama deployments:
# LABEL_SPACE_LLM_API_BASE=http://localhost:11434

# For production deployment with external network:
# ALLOWED_ORIGINS=https://coral.ni.dfki.de,http://localhost:3000
# PROMPTED_SEGMENTATION_BACKEND_URL=
# AUTOMATIC_SEGMENTATION_BACKEND_URL=

